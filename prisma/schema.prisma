generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipStatus {
  ACTIVE
  INACTIVE

  @@map("membership_status")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

enum InventoryOperationType {
  ENTRY
  EXIT
  ADJUSTMENT
  TRANSFER
  ORDER_RESERVE
  ORDER_RELEASE
  ORDER_FULFILL

  @@map("inventory_operation_type")
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique @db.VarChar(320)
  passwordHash    String           @map("password_hash") @db.Text
  displayName     String           @map("display_name") @db.VarChar(120)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  memberships     Membership[]
  sentInvitations Invitation[]     @relation("InvitedByUser")
  refreshSessions RefreshSession[]
  auditEvents     AuditEvent[]

  @@index([isActive])
  @@map("users")
}

model Organization {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(120)
  slug               String              @unique @db.VarChar(80)
  timezone           String              @default("UTC") @db.VarChar(64)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  memberships        Membership[]
  invitations        Invitation[]
  branches           Branch[]
  products           Product[]
  suppliers          Supplier[]
  idempotencyRecords IdempotencyRecord[]
  auditEvents        AuditEvent[]

  @@map("organizations")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(30)
  name            String           @db.VarChar(80)
  description     String?          @db.Text
  rolePermissions RolePermission[]
  memberships     Membership[]
  invitations     Invitation[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(80)
  description     String           @db.Text
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Membership {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  roleId              String               @map("role_id") @db.Uuid
  status              MembershipStatus     @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  inventoryOperations InventoryOperation[]

  @@unique([userId, organizationId])
  @@index([userId, status])
  @@index([organizationId, status, roleId])
  @@map("memberships")
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  roleId          String           @map("role_id") @db.Uuid
  email           String           @db.VarChar(320)
  tokenHash       String           @unique @map("token_hash") @db.Text
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz
  acceptedAt      DateTime?        @map("accepted_at") @db.Timestamptz
  revokedAt       DateTime?        @map("revoked_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedByUser   User             @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  role            Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([email, status])
  @@index([expiresAt])
  @@map("invitations")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Text
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  lastUsedAt DateTime  @map("last_used_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  userAgent  String?   @map("user_agent") @db.Text
  ipAddress  String?   @map("ip_address") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String       @db.VarChar(40)
  name           String       @db.VarChar(120)
  address        String?      @db.Text
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouses     Warehouse[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive, name])
  @@map("branches")
}

model Warehouse {
  id                String             @id @default(uuid()) @db.Uuid
  branchId          String             @map("branch_id") @db.Uuid
  code              String             @db.VarChar(40)
  name              String             @db.VarChar(120)
  description       String?            @db.Text
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  inventoryBalances InventoryBalance[]

  @@unique([branchId, code])
  @@index([branchId, isActive, name])
  @@map("warehouses")
}

model Product {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  sku               String             @db.VarChar(80)
  name              String             @db.VarChar(160)
  description       String?            @db.Text
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productSuppliers  ProductSupplier[]
  inventoryBalances InventoryBalance[]

  @@unique([organizationId, sku])
  @@index([organizationId, isActive, name])
  @@map("products")
}

model Supplier {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  code              String             @db.VarChar(40)
  name              String             @db.VarChar(160)
  contactName       String?            @map("contact_name") @db.VarChar(120)
  email             String?            @db.VarChar(320)
  phone             String?            @db.VarChar(40)
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productSuppliers  ProductSupplier[]
  inventoryEntries  InventoryEntry[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive, name])
  @@map("suppliers")
}

model ProductSupplier {
  productId  String   @map("product_id") @db.Uuid
  supplierId String   @map("supplier_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([productId, supplierId])
  @@index([supplierId])
  @@map("product_suppliers")
}

model InventoryBalance {
  id           String              @id @default(uuid()) @db.Uuid
  warehouseId  String              @map("warehouse_id") @db.Uuid
  productId    String              @map("product_id") @db.Uuid
  onHand       Int                 @default(0) @map("on_hand")
  reserved     Int                 @default(0)
  minimumStock Int                 @default(0) @map("minimum_stock")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product      Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  movements    InventoryMovement[]

  @@unique([warehouseId, productId])
  @@index([productId])
  @@index([warehouseId])
  @@map("inventory_balances")
}

model InventoryOperation {
  id                String                 @id @default(uuid()) @db.Uuid
  actorMembershipId String                 @map("actor_membership_id") @db.Uuid
  type              InventoryOperationType
  reason            String?                @db.VarChar(240)
  externalReference String?                @map("external_reference") @db.VarChar(120)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz
  actorMembership   Membership             @relation(fields: [actorMembershipId], references: [id], onDelete: Restrict)
  movements         InventoryMovement[]
  entry             InventoryEntry?

  @@index([actorMembershipId, createdAt])
  @@index([type, createdAt])
  @@map("inventory_operations")
}

model InventoryMovement {
  id            String             @id @default(uuid()) @db.Uuid
  operationId   String             @map("operation_id") @db.Uuid
  balanceId     String             @map("balance_id") @db.Uuid
  onHandDelta   Int                @map("on_hand_delta")
  reservedDelta Int                @map("reserved_delta")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  operation     InventoryOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  balance       InventoryBalance   @relation(fields: [balanceId], references: [id], onDelete: Restrict)

  @@unique([operationId, balanceId])
  @@index([balanceId, id])
  @@map("inventory_movements")
}

model InventoryEntry {
  operationId String             @id @map("operation_id") @db.Uuid
  supplierId  String?            @map("supplier_id") @db.Uuid
  operation   InventoryOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  supplier    Supplier?          @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([supplierId])
  @@map("inventory_entries")
}

model IdempotencyRecord {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  key            String       @db.VarChar(128)
  requestHash    String       @map("request_hash") @db.Char(64)
  method         String       @db.VarChar(16)
  route          String       @db.VarChar(255)
  responseStatus Int          @map("response_status")
  responseBody   Json         @map("response_body")
  resourceType   String?      @map("resource_type") @db.VarChar(80)
  resourceId     String?      @map("resource_id") @db.VarChar(80)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  expiresAt      DateTime?    @map("expires_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@index([organizationId, createdAt])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  action         String        @db.VarChar(80)
  entityType     String        @map("entity_type") @db.VarChar(80)
  entityId       String?       @map("entity_id") @db.Uuid
  requestId      String        @map("request_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  changes        AuditChange[]

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@map("audit_events")
}

model AuditChange {
  id           String     @id @default(uuid()) @db.Uuid
  auditEventId String     @map("audit_event_id") @db.Uuid
  field        String     @db.VarChar(120)
  oldValue     String?    @map("old_value") @db.Text
  newValue     String?    @map("new_value") @db.Text
  auditEvent   AuditEvent @relation(fields: [auditEventId], references: [id], onDelete: Cascade)

  @@unique([auditEventId, field])
  @@map("audit_changes")
}


